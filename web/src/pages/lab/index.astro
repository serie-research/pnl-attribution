---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/>
<title>Signal attribution · Python lab</title></head>
<body><main data-base={base}>
<h1>Signal attribution · Python lab</h1>
<p>Execute the synthetic examples in your browser. Python and the numerical packages download from jsDelivr when you start. No account or installation is needed.</p>
<p>Run cells in order: they share one Python session. You can edit code before running it. The dense solver and approximate Shapley examples may take several minutes. Closing this page loses edits and Python state.</p>
<p>Pyodide 0.29.5 · NumPy · SciPy · CVXPY · Clarabel. Once all resources have loaded, this lab caches them for offline reuse in this browser (subject to browser storage eviction). HTTPS or localhost is required.</p>
<nav><button id="start">Start Python</button> <button id="all" disabled>Run all cells</button> <button id="stop" disabled>Stop / reset session</button> <button id="theme">Switch theme</button></nav>
<p id="status" role="status" aria-live="polite">Python has not started.</p>
<div id="cells"></div>
</main>
<script>
const base = document.querySelector('main')!.dataset.base || '';
const start = document.querySelector<HTMLButtonElement>('#start')!;
const all = document.querySelector<HTMLButtonElement>('#all')!;
const stop = document.querySelector<HTMLButtonElement>('#stop')!;
const status = document.querySelector('#status')!;
const root = document.querySelector('#cells')!;
let worker: Worker | undefined;
let ready = false;
let busy = false;
let resolveRun: (() => void) | undefined;
let cells: {cell_type: string, source: string[]}[] = [];
const outputs = new Map<number, HTMLPreElement>();
const editors = new Map<number, HTMLTextAreaElement>();
const buttons: HTMLButtonElement[] = [];
const evidence: any = { events: [], results: [], done: false };
(window as any).labEvidence = evidence;
function controls() {
  all.disabled = !ready || busy;
  start.disabled = !!worker;
  stop.disabled = !worker;
  buttons.forEach(b => b.disabled = !ready || busy);
}
async function notebook() {
  const response = await fetch(`${base}/lab/notebook.json`);
  if (!response.ok) throw new Error(`Notebook: HTTP ${response.status}`);
  cells = (await response.json()).cells;
  root.replaceChildren(); outputs.clear(); editors.clear(); buttons.length = 0;
  cells.forEach((cell, index) => {
    const section = document.createElement('section');
    if (cell.cell_type !== 'code') {
      // Plain source preserves formulas and links without executing notebook HTML.
      const text = document.createElement('pre'); text.className = 'notes';
      text.textContent = cell.source.join(''); section.append(text);
    } else {
      const label = document.createElement('label'); label.htmlFor = `cell-${index}`;
      label.textContent = `Python cell ${index} (notebook index)`;
      const editor = document.createElement('textarea'); editor.id = label.htmlFor;
      editor.value = cell.source.join(''); editor.spellcheck = false;
      editor.rows = Math.min(22, editor.value.split('\n').length + 1);
      const button = document.createElement('button'); button.textContent = 'Run cell';
      button.disabled = true; button.onclick = () => run(index);
      const output = document.createElement('pre'); output.setAttribute('aria-label', `Output of cell ${index}`);
      section.append(label, editor, button, output);
      editors.set(index, editor); outputs.set(index, output); buttons.push(button);
    }
    root.append(section);
  });
}
function run(index: number) {
  if (!ready || busy) return Promise.resolve();
  busy = true; controls(); outputs.get(index)!.textContent = '';
  status.textContent = `Running cell ${index}…`;
  return new Promise<void>(resolve => {
    resolveRun = resolve;
    worker!.postMessage({ type: 'run', index, source: editors.get(index)!.value });
  });
}
start.onclick = async () => {
  try {
    start.disabled = true; status.textContent = 'Downloading Python and packages…';
    if ('serviceWorker' in navigator) {
      await navigator.serviceWorker.register(`${base}/lab/sw.js`, { scope: `${base}/lab/` });
      await navigator.serviceWorker.ready;
      if (!navigator.serviceWorker.controller) await new Promise<void>(resolve =>
        navigator.serviceWorker.addEventListener('controllerchange', () => resolve(), { once: true }));
    }
    await notebook();
    worker = new Worker(`${base}/lab/worker.mjs`, { type: 'module' });
    worker.onmessage = ({ data }) => {
      evidence.events.push(data);
      if (data.type === 'ready') {
        ready = true; evidence.runtime = data; status.textContent = 'Python ready. Run cells in order.';
      } else if (data.type === 'stdout' || data.type === 'stderr') {
        const output = outputs.get(data.index); if (output) output.textContent += data.text + '\n';
      } else if (data.type === 'result') {
        evidence.results.push(data);
        if (data.error) outputs.get(data.index)!.textContent += data.error + '\n';
        outputs.get(data.index)!.textContent += `\n${data.error ? 'Failed' : 'Done'} in ${(data.ms / 1000).toFixed(3)} s`;
        busy = false; status.textContent = `Cell ${data.index}: ${data.error ? 'failed' : 'done'}.`;
        resolveRun?.(); resolveRun = undefined;
      } else if (data.type === 'fatal') {
        status.textContent = data.error; worker?.terminate(); worker = undefined; ready = false; busy = false;
        resolveRun?.(); resolveRun = undefined;
      }
      controls();
    };
    worker.onerror = event => {
      status.textContent = event.message; worker?.terminate(); worker = undefined; ready = false; busy = false;
      resolveRun?.(); resolveRun = undefined; controls();
    };
    worker.postMessage({ type: 'init' }); controls();
  } catch (error) { status.textContent = String(error); start.disabled = false; }
};
all.onclick = async () => {
  evidence.done = false;
  const first = evidence.results.length;
  for (const [index] of editors) { if (!ready) break; await run(index); }
  evidence.done = true;
  const results = evidence.results.slice(first);
  const failed = results.filter((result: any) => result.error).length;
  status.textContent = `Finished ${results.length}/${editors.size} cells; ${failed} failed.`;
};
stop.onclick = () => {
  worker?.terminate(); worker = undefined; ready = false; busy = false;
  resolveRun?.(); resolveRun = undefined; status.textContent = 'Session cleared. Start Python to begin again.'; controls();
};
document.querySelector('#theme')!.addEventListener('click', () => {
  const dark = getComputedStyle(document.documentElement).colorScheme === 'dark' ||
    (!document.documentElement.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
  document.documentElement.dataset.theme = dark ? 'light' : 'dark';
});
</script>
<style is:global>
:root { color-scheme: light dark; --bg: #faf9f6; --fg: #222; --panel: #fff; --border: #888; }
@media (prefers-color-scheme: dark) { :root { --bg: #181b20; --fg: #eee; --panel: #242830; } }
:root[data-theme="dark"] { color-scheme: dark; --bg: #181b20; --fg: #eee; --panel: #242830; }
:root[data-theme="light"] { color-scheme: light; --bg: #faf9f6; --fg: #222; --panel: #fff; }
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--fg); font: 17px/1.55 system-ui, sans-serif; }
main { max-width: 960px; padding: 24px 18px; margin: auto; }
h1 { font-size: clamp(1.6rem, 5vw, 2.2rem); line-height: 1.2; }
nav { display: flex; flex-wrap: wrap; gap: 8px; }
button { padding: 10px 14px; font: inherit; cursor: pointer; }
section { margin: 24px 0; min-width: 0; }
label { display: block; font-weight: 600; }
textarea { display: block; width: 100%; padding: 12px; background: var(--panel); color: var(--fg); border: 1px solid var(--border); font: 14px/1.5 monospace; white-space: pre; overflow: auto; margin: 8px 0; }
pre { padding: 12px; background: var(--panel); white-space: pre-wrap; overflow-wrap: anywhere; font: 14px/1.5 monospace; }
.notes { font: inherit; padding: 0; background: transparent; }
</style>
</body></html>
